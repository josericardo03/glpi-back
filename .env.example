# Uso local. No servidor Linux, o docker-compose do front define banco, JWT e a senha do admin.
PORT=3000
JWT_SECRET="troque-por-pelo-menos-32-caracteres-aleatorios"
JWT_EXPIRES_IN="15m"
CORS_ORIGIN="http://localhost:5173"

DATABASE_URL="postgresql://postgres:12345678@127.0.0.1:5432/itsm?connection_limit=10"
# PG_POOL_MAX tem prioridade sobre connection_limit. O parâmetro é removido antes de conectar no Postgres.
DIRECT_URL="postgresql://postgres:12345678@127.0.0.1:5432/itsm"

SEED_ADMIN_EMAIL="admin@itsm.local"
SEED_ADMIN_PASSWORD="Admin@123456"

# Segredo próprio para criptografar credenciais de integrações. Sem ele, usa o JWT_SECRET.
# Para trocar: defina o novo aqui; o JWT_SECRET antigo continua sendo aceito na leitura.
# INTEGRACOES_SECRET="outro-segredo-forte"

# Proxies confiáveis para req.ip (auditoria). Padrão: redes privadas (nginx do docker-compose).
# TRUST_PROXY="loopback, linklocal, uniquelocal"

# true = falha ao subir se o schema/migrations não puderem ser aplicados (padrão em produção).
# DB_BOOTSTRAP_STRICT=true

# URL pública do front: usada nos links dos e-mails (redefinição de senha, avisos).
# APP_URL="https://suporte.suaempresa.com.br"

# Libera webhooks para IPs de rede privada (serviços internos). Loopback e link-local seguem barrados.
# REDE_PERMITE_INTERNA=true

# Intervalo da varredura de SLA em ms (padrão 60000).
# SLA_VARREDURA_MS=60000
